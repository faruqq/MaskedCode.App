<Window x:Class="MaskedCode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MaskedCode"
        Width="1536"
        Height="1024"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="43"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="96" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Windows başlık çubuğu -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="&lt;/&gt;" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="MaskedCode" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                Content="&#xE921;"
                                ToolTip="Simge durumuna küçült" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeRestoreButton_Click"
                                Content="&#xE922;"
                                ToolTip="Büyüt veya geri yükle" />
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                                Click="CloseButton_Click"
                                Content="&#xE8BB;"
                                ToolTip="Kapat" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ürün başlığı -->
            <Grid Grid.Row="1" Margin="40,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="96"
        Height="96"
        Margin="0,0,14,0"
        Background="{StaticResource WindowBrush}"
        ClipToBounds="True"
        CornerRadius="18"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

                        <Grid Width="96"
          Height="96"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ClipToBounds="True"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">

                            <Grid.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5"
                                 GradientOrigin="0.5,0.5"
                                 RadiusX="0.5"
                                 RadiusY="0.5">
                                    <GradientStop Color="#FFFFFFFF"
                              Offset="0.00" />
                                    <GradientStop Color="#FFFFFFFF"
                              Offset="0.68" />
                                    <GradientStop Color="#F8FFFFFF"
                              Offset="0.78" />
                                    <GradientStop Color="#C0FFFFFF"
                              Offset="0.90" />
                                    <GradientStop Color="#00FFFFFF"
                              Offset="1.00" />
                                </RadialGradientBrush>
                            </Grid.OpacityMask>

                            <MediaElement x:Name="HeaderAnimationPrimaryMediaElement"
                      Opacity="1"
                      IsMuted="True"
                      Loaded="HeaderAnimationMediaElement_Loaded"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="HeaderAnimationMediaElement_MediaOpened"
                      MediaEnded="HeaderAnimationMediaElement_MediaEnded"
                      MediaFailed="HeaderAnimationMediaElement_MediaFailed"
                      ScrubbingEnabled="True"
                      Stretch="Uniform"
                      SnapsToDevicePixels="True" />

                            <MediaElement x:Name="HeaderAnimationSecondaryMediaElement"
                      Opacity="0"
                      IsMuted="True"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="HeaderAnimationMediaElement_MediaOpened"
                      MediaEnded="HeaderAnimationMediaElement_MediaEnded"
                      MediaFailed="HeaderAnimationMediaElement_MediaFailed"
                      ScrubbingEnabled="True"
                      Stretch="Uniform"
                      SnapsToDevicePixels="True" />

                            <Image x:Name="HeaderAnimationImage"
               Opacity="0"
               IsHitTestVisible="False"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="MaskedCode" />
                        <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       Text="Kaynak kodunuzu güvenli biçimde maskeleyin ve geri açın." />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
            Padding="15,8"
            VerticalAlignment="Center"
            Background="#112D27"
            BorderBrush="#205044"
            BorderThickness="1"
            CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="16"
                       Text="✓" />
                        <TextBlock Foreground="#CFEDE5"
                       FontSize="14"
                       Text="PL/I ve EGL hazır" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="20,4,20,20"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <TabControl x:Name="MainTabControl"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE72E;" />
                                <TextBlock Text="Kod Maskeleme" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid x:Name="MaskWorkspace">
                            <Grid x:Name="MaskFocusContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>

                                <!-- Maskeleme özet şeridi -->
                                <Border Grid.Row="0"
                                        Margin="16,8,16,6"
                                        Background="{StaticResource EditorBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                            <TextBlock x:Name="MaskLanguageSummaryTextBlock" Text="PL/I" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="26,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock x:Name="MaskSourceSummaryIcon"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="○" />
                                            <TextBlock x:Name="SelectedFileSummaryTextBlock"
                                                       MaxWidth="170"
                                                       Text="Kod yapıştırılabilir"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Margin="26,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                            <TextBlock x:Name="MaskModeSummaryTextBlock" Text="Maksimum Gizlilik" />
                                        </StackPanel>

                                        <Button x:Name="MaskSettingsButton"
                                                Grid.Column="4"
                                                Margin="16,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="MaskSettingsToggleButton_Click"
                                                Content="&#xE713;"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                ToolTip="Maskeleme ayarlarını aç" />

                                    </Grid>
                                </Border>

                                <!-- Maskeleme editörleri -->
                                <Grid x:Name="MaskEditorGrid" Grid.Row="1" Margin="16,8,16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="MaskLeftColumn" Width="*" MinWidth="300" />
                                        <ColumnDefinition x:Name="MaskSplitterColumn" Width="14" />
                                        <ColumnDefinition x:Name="MaskRightColumn" Width="*" MinWidth="300" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="MaskLeftEditorCard"
                                            Grid.Column="0"
                                            ClipToBounds="True"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE943;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Kaynak Kod" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="ExpandEditorButton_Click"
                                                        Tag="MaskLeft"
                                                        Content="&#xE740;"
                                                        ToolTip="Kaynak kod editörünü genişlet" />
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border ClipToBounds="True"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,1,0">
                                                        <TextBlock x:Name="SourceLineNumbersTextBlock"
                                                                   Padding="0,12,14,12"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="14"
                                                                   LineHeight="22"
                                                                   Text="1" />
                                                    </Border>
                                                    <RichTextBox x:Name="SourceSyntaxRichTextBox"
                                                                 Grid.Column="1"
                                                                 Padding="14,12"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 ClipToBounds="True"
                                                                 Focusable="False"
                                                                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                                 FontSize="14"
                                                                 IsHitTestVisible="False"
                                                                 IsReadOnly="True"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                                    <TextBox x:Name="SourceCodeTextBox"
                                                             Grid.Column="1"
                                                             Padding="14,12"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             ClipToBounds="True"
                                                             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                             FontSize="14"
                                                             Foreground="Transparent"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             TextBlock.LineHeight="22"
                                                             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
                                                             TextChanged="SourceCodeTextBox_TextChanged"
                                                             TextWrapping="NoWrap"
                                                             VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <GridSplitter x:Name="MaskGridSplitter"
                                                  Grid.Column="1"
                                                  Width="14"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  Cursor="SizeWE"
                                                  DragDelta="EditorGridSplitter_DragDelta"
                                                  MouseDoubleClick="EditorGridSplitter_MouseDoubleClick"
                                                  ResizeBehavior="PreviousAndNext"
                                                  ResizeDirection="Columns"
                                                  ShowsPreview="False"
                                                  ToolTip="Editörlerin genişliğini değiştirmek için sürükleyin. Sıfırlamak için çift tıklayın.">
                                        <GridSplitter.Template>
                                            <ControlTemplate TargetType="GridSplitter">
                                                <Border x:Name="SplitterHitArea"
                                                        Width="14"
                                                        Background="Transparent">
                                                    <Border x:Name="SplitterHandle"
                                                            Width="6"
                                                            Height="54"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource BorderStrongBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#101B2E" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimarySoftBrush}" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#17243A" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </GridSplitter.Template>
                                    </GridSplitter>

                                    <Border x:Name="MaskRightEditorCard"
                                            Grid.Column="2"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE72E;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Maskelenmiş Kod" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button x:Name="CopyButton"
                                                            Margin="0,0,8,0"
                                                            Click="CopyButton_Click"
                                                            Content="&#xE8C8;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kopyala" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button x:Name="SaveFileButton"
                                                            Margin="0,0,8,0"
                                                            Click="SaveFileButton_Click"
                                                            Content="&#xE74E;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kodu Kaydet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button x:Name="SaveVaultButton"
                                                            Margin="0,0,8,0"
                                                            Click="SaveVaultButton_Click"
                                                            Content="&#xE72E;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kasa Dosyasını Kaydet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button Click="ExpandEditorButton_Click"
                                                            Content="&#xE740;"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Tag="MaskRight">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Maskelenmiş kod editörünü genişlet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,1,0">
                                                        <TextBlock x:Name="MaskedLineNumbersTextBlock"
                                                                   Padding="0,12,14,12"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="14"
                                                                   LineHeight="22"
                                                                   Text="1" />
                                                    </Border>
                                                    <RichTextBox x:Name="MaskedSyntaxRichTextBox"
                                                                 Grid.Column="1"
                                                                 Padding="14,12"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Focusable="False"
                                                                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                                 FontSize="14"
                                                                 IsHitTestVisible="False"
                                                                 IsReadOnly="True"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                                    <TextBox x:Name="MaskedCodeTextBox"
                                                             Grid.Column="1"
                                                             Padding="14,12"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                             FontSize="14"
                                                             Foreground="Transparent"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             IsReadOnly="True"
                                                             TextBlock.LineHeight="22"
                                                             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
                                                             TextChanged="CodeOutputTextBox_TextChanged"
                                                             TextWrapping="NoWrap"
                                                             VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="MaskStatusBorder"
                                        Grid.Row="2"
                                        Margin="16,6,16,12"
                                        Padding="16,0"
                                        Background="{StaticResource SuccessSurfaceBrush}"
                                        BorderBrush="#205044"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MaskStatusIconBorder"
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <TextBlock x:Name="MaskStatusIconText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                        </Border>
                                        <TextBlock x:Name="MaskStatusTextBlock"
                                                   Grid.Column="1"
                                                   Margin="14,0"
                                                   VerticalAlignment="Center"
                                                   Text="Kod yapıştırabilir veya bir kaynak dosya seçebilirsiniz."
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DismissStatusButton_Click"
                                                Content="&#xE8BB;"
                                                ToolTip="Bildirimi kapat" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Maskeleme ayar çekmecesi -->
                            <Grid x:Name="MaskDrawerLayer"
                                  Panel.ZIndex="20"
                                  Visibility="Collapsed">
                                <Button Background="{StaticResource ScrimBrush}"
                                        BorderThickness="0"
                                        Click="DrawerScrim_Click"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="MaskSettingsDrawer"
                                        Width="500"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          Direction="180"
                                                          Opacity="0.35"
                                                          ShadowDepth="8"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="24,18,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Text="Maskeleme Ayarları" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Kod maskeleme seçeneklerini düzenleyin" />
                                            </StackPanel>
                                            <Button x:Name="MaskDrawerCloseButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="&#xE8BB;"
                                                    ToolTip="Ayarları kapat" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="24,0,24,8">
                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Kaynak dil" />
                                            <ComboBox x:Name="LanguageComboBox"
                                                          SelectionChanged="LanguageComboBox_SelectionChanged"
                                                          SelectedIndex="0">
                                                <ComboBoxItem Content="PL/I" Tag="PL1" />
                                                <ComboBoxItem Content="EGL" Tag="EGL" />
                                            </ComboBox>

                                            <Border Margin="0,18,0,0"
                                                        Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="MaskSelectedFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
