                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
