                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#101B2E" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimarySoftBrush}" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#17243A" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </GridSplitter.Template>
