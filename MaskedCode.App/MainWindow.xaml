                                                Click="DismissStatusButton_Click"
                                                Content="&#xE8BB;"
                                                ToolTip="Bildirimi kapat" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Geri açma ayar çekmecesi -->
                            <Grid x:Name="RestoreDrawerLayer"
                                  Panel.ZIndex="20"
                                  Visibility="Collapsed">
                                <Button Background="{StaticResource ScrimBrush}"
                                        BorderThickness="0"
                                        Click="DrawerScrim_Click"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="RestoreSettingsDrawer"
                                        Width="450"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          Direction="180"
                                                          Opacity="0.35"
                                                          ShadowDepth="8"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="24,18,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Text="Geri Açma Ayarları" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Dosya ve kasa doğrulama seçeneklerini düzenleyin" />
                                            </StackPanel>
                                            <Button x:Name="RestoreDrawerCloseButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="&#xE8BB;"
                                                    ToolTip="Ayarları kapat" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="24,0,24,8">
                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Maskelenmiş Dosya" />
                                            <Border Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="RestoreMaskedFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
                                                            <TextBlock x:Name="SelectedMaskedFileTextBlock"
                                                                           MaxWidth="210"
                                                                           FontWeight="SemiBold"
                                                                           Text="Dosya seçilmedi"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="SelectedMaskedFileMetaTextBlock"
                                                                       Margin="22,5,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Text="Desteklenen: .pli, .pl1, .egl" />
                                                    </StackPanel>
                                                    <Button x:Name="SelectMaskedFileButton"
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Click="SelectMaskedFileButton_Click"
                                                                Content="Dosya Seç" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Margin="0,20,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Şifreli Eşleme Kasası" />
                                            <Border Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="RestoreVaultFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
                                                            <TextBlock x:Name="SelectedVaultFileTextBlock"
                                                                           MaxWidth="210"
                                                                           FontWeight="SemiBold"
                                                                           Text="Kasa seçilmedi"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="SelectedVaultFileMetaTextBlock"
                                                                       Margin="22,5,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Text=".mcvault dosyası seçin" />
                                                    </StackPanel>
                                                    <Button x:Name="SelectVaultFileButton"
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Click="SelectVaultFileButton_Click"
                                                                Content="Kasa Dosyası Seç" />
                                                </Grid>
                                            </Border>

                                            <Border Height="1"
                                                        Margin="0,20"
                                                        Background="{StaticResource BorderBrush}" />

                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Parola Yöntemi" />
                                            <Border Padding="3"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="ManualRestorePasswordRadioButton"
                                                                     GroupName="RestorePasswordSource"
                                                                     Content="Parolayı Elle Gir"
                                                                     IsChecked="True"
                                                                     Checked="RestorePasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                    <RadioButton x:Name="FileRestorePasswordRadioButton"
                                                                     Grid.Column="1"
                                                                     GroupName="RestorePasswordSource"
                                                                     Content="Parolayı Dosyadan Kullan"
                                                                     Checked="RestorePasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel x:Name="ManualRestorePasswordPanel" Margin="0,10,0,0">
                                                <Border Style="{StaticResource PasswordInputStyle}">
                                                    <Grid>
                                                        <TextBlock x:Name="RestorePasswordPlaceholderTextBlock"
                                                                       Margin="14,0,48,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       IsHitTestVisible="False"
                                                                       Text="Kasa parolasını girin" />
                                                        <PasswordBox x:Name="RestoreVaultPasswordBox"
                                                                         Margin="12,0,48,0"
                                                                         MaxLength="128"
                                                                         PasswordChanged="RestorePasswordInput_Changed" />
                                                        <TextBox x:Name="RestoreVaultPasswordTextBox"
                                                                     Margin="12,0,48,0"
                                                                     MaxLength="128"
                                                                     TextChanged="RestorePasswordInput_Changed"
                                                                     Visibility="Collapsed" />
                                                        <Button x:Name="RestorePasswordVisibilityButton"
                                                                    Width="42"
                                                                    Height="42"
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Click="RestorePasswordVisibilityButton_Click"
                                                                    Content="&#xE890;"
                                                                    ToolTip="Parolayı göster veya gizle" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="RestorePasswordValidationTextBlock"
                                                               Margin="2,8,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               Text="Kasa parolasını girin." />
                                            </StackPanel>

                                            <Border x:Name="RestorePasswordFilePanel"
                                                        Margin="0,10,0,0"
                                                        Padding="12"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RestorePasswordFileTextBlock"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="Parola dosyası seçilmedi"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                Click="SelectRestorePasswordFileButton_Click"
                                                                Content="Dosya Seç" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="24,12,24,22">
                                            <Button x:Name="UnmaskButton"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="UnmaskButton_Click"
                                                    Content="⛨  Ayarları Uygula ve Kodu Geri Aç"
                                                    IsEnabled="False" />
                                            <Button Margin="0,8,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="İptal" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Mevcut iş mantığının ortak durum hedefi -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Text="Kod yapıştırabilir veya bir kaynak dosya seçebilirsiniz." />
        </Grid>
    </Border>
</Window>
