<Window x:Class="MaskedCode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MASKOD"
        Width="1536"
        Height="1024"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="43"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="96" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Windows başlık çubuğu -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="116"
                           Height="28"
                           Margin="18,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Source="/MaskedCode.App;component/Assets/Brand/maskod-logo.png"
                           Stretch="Uniform" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                Content="&#xE921;"
                                ToolTip="Simge durumuna küçült" />

                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeRestoreButton_Click"
                                Content="&#xE922;"
                                ToolTip="Büyüt veya geri yükle" />

                        <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                                Click="CloseButton_Click"
                                Content="&#xE8BB;"
                                ToolTip="Kapat" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ürün başlığı -->
            <Grid Grid.Row="1"
                  Margin="40,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">

                    <!-- Animasyonlu MaskState karakteri -->
                    <Border Width="96"
                            Height="96"
                            Margin="0,0,14,0"
                            Background="{StaticResource WindowBrush}"
                            ClipToBounds="True"
                            CornerRadius="18"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">

                        <Grid Width="96"
                              Height="96"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ClipToBounds="True"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True">

                            <Grid.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5"
                                                     GradientOrigin="0.5,0.5"
                                                     RadiusX="0.5"
                                                     RadiusY="0.5">
                                    <GradientStop Color="#FFFFFFFF"
                                                  Offset="0.00" />

                                    <GradientStop Color="#FFFFFFFF"
                                                  Offset="0.68" />

                                    <GradientStop Color="#F8FFFFFF"
                                                  Offset="0.78" />

                                    <GradientStop Color="#C0FFFFFF"
                                                  Offset="0.90" />

                                    <GradientStop Color="#00FFFFFF"
                                                  Offset="1.00" />
                                </RadialGradientBrush>
                            </Grid.OpacityMask>

                            <MediaElement x:Name="HeaderAnimationPrimaryMediaElement"
                                          Opacity="1"
                                          IsMuted="True"
                                          Loaded="HeaderAnimationMediaElement_Loaded"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          MediaOpened="HeaderAnimationMediaElement_MediaOpened"
                                          MediaEnded="HeaderAnimationMediaElement_MediaEnded"
                                          MediaFailed="HeaderAnimationMediaElement_MediaFailed"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          SnapsToDevicePixels="True" />

                            <MediaElement x:Name="HeaderAnimationSecondaryMediaElement"
                                          Opacity="0"
                                          IsMuted="True"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          MediaOpened="HeaderAnimationMediaElement_MediaOpened"
                                          MediaEnded="HeaderAnimationMediaElement_MediaEnded"
                                          MediaFailed="HeaderAnimationMediaElement_MediaFailed"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          SnapsToDevicePixels="True" />

                            <Image x:Name="HeaderAnimationImage"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <!-- MASKOD ürün logosu ve açıklaması -->
                    <StackPanel VerticalAlignment="Center">
                        <Image Width="184"
                               Height="42"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               Source="/MaskedCode.App;component/Assets/Brand/maskod-logo.png"
                               Stretch="Uniform" />

                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   Text="Kaynak kodunuzu güvenli biçimde maskeleyin ve geri açın." />
                    </StackPanel>
                </StackPanel>

                <!-- Dil destek durumu -->
                <Border Grid.Column="1"
        Padding="16,9"
        VerticalAlignment="Center"
        Background="#112D27"
        BorderBrush="#205044"
        BorderThickness="1"
        CornerRadius="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SuccessBrush}"
                   FontSize="14"
                   Text="✓" />

                        <TextBlock Grid.Row="0"
           Grid.Column="1"
           VerticalAlignment="Center"
           Foreground="#CFEDE5"
           FontSize="14"
           Text="PL/I, EGL ve C# kullanılabilir" />

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="20,4,20,20"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <TabControl x:Name="MainTabControl"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE72E;" />
                                <TextBlock Text="Kod Maskeleme" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid x:Name="MaskWorkspace">
                            <Grid x:Name="MaskFocusContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>

                                <!-- Maskeleme özet şeridi -->
                                <Border Grid.Row="0"
                                        Margin="16,8,16,6"
                                        Background="{StaticResource EditorBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                            <TextBlock x:Name="MaskLanguageSummaryTextBlock" Text="PL/I" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="26,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock x:Name="MaskSourceSummaryIcon"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="○" />
                                            <TextBlock x:Name="SelectedFileSummaryTextBlock"
                                                       MaxWidth="170"
                                                       Text="Kod yapıştırılabilir"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Margin="26,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                            <TextBlock x:Name="MaskModeSummaryTextBlock" Text="Maksimum Gizlilik" />
                                        </StackPanel>

                                        <Button x:Name="MaskSettingsButton"
                                                Grid.Column="4"
                                                Margin="16,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="MaskSettingsToggleButton_Click"
                                                Content="&#xE713;"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                ToolTip="Maskeleme ayarlarını aç" />

                                    </Grid>
                                </Border>

                                <!-- Maskeleme editörleri -->
                                <Grid x:Name="MaskEditorGrid" Grid.Row="1" Margin="16,8,16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="MaskLeftColumn" Width="*" MinWidth="300" />
                                        <ColumnDefinition x:Name="MaskSplitterColumn" Width="14" />
                                        <ColumnDefinition x:Name="MaskRightColumn" Width="*" MinWidth="300" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="MaskLeftEditorCard"
                                            Grid.Column="0"
                                            ClipToBounds="True"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE943;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Kaynak Kod" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="ExpandEditorButton_Click"
                                                        Tag="MaskLeft"
                                                        Content="&#xE740;"
                                                        ToolTip="Kaynak kod editörünü genişlet" />
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border ClipToBounds="True"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
                                                        <Canvas ClipToBounds="True">
                                                            <TextBlock x:Name="SourceLineNumbersTextBlock"
                       Canvas.Right="14"
                       Padding="0,12,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       LineHeight="19"
                       Text="1" />
                                                        </Canvas>
                                                    </Border>

                                                    <Canvas Grid.Column="1"
            ClipToBounds="True"
            IsHitTestVisible="False">
                                                        <Border x:Name="SourceActiveLineBorder"
                Canvas.Left="0"
                Canvas.Right="0"
                Width="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                Height="19"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="#405B8CFF"
                BorderThickness="0,1,0,1"
                Opacity="0"
                IsHitTestVisible="False" />
                                                    </Canvas>

                                                    <RichTextBox x:Name="SourceSyntaxRichTextBox"
                 Grid.Column="1"
                 Padding="14,12"
                 Background="Transparent"
                 BorderThickness="0"
                 ClipToBounds="True"
                 Focusable="False"
                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                 FontSize="14"
                 IsHitTestVisible="False"
                 IsReadOnly="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />

                                                    <TextBox x:Name="SourceCodeTextBox"
             Grid.Column="1"
             Padding="14,12"
             AcceptsReturn="True"
             AcceptsTab="True"
             ClipToBounds="True"
             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
             FontSize="14"
             Foreground="Transparent"
             HorizontalScrollBarVisibility="Auto"
             TextBlock.LineHeight="19"
             TextBlock.LineStackingStrategy="BlockLineHeight"
             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
             TextChanged="SourceCodeTextBox_TextChanged"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1"
                                          Width="14"
                                          Panel.ZIndex="2">
                                        <GridSplitter x:Name="MaskGridSplitter"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  Cursor="SizeWE"
                                                  DragDelta="EditorGridSplitter_DragDelta"
                                                  MouseDoubleClick="EditorGridSplitter_MouseDoubleClick"
                                                  ResizeBehavior="PreviousAndNext"
                                                  ResizeDirection="Columns"
                                                  ShowsPreview="False"
                                                  ToolTip="Editörlerin genişliğini değiştirmek için sürükleyin. Sıfırlamak için çift tıklayın.">
                                            <GridSplitter.Template>
                                                <ControlTemplate TargetType="GridSplitter">
                                                    <Border x:Name="SplitterHitArea"
                                                        Width="14"
                                                        Background="Transparent">
                                                        <Border x:Name="SplitterHandle"
                                                            Width="6"
                                                            Height="54"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource BorderStrongBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                            <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#101B2E" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimarySoftBrush}" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#17243A" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </GridSplitter.Template>
                                        </GridSplitter>

                                        <ToggleButton x:Name="MaskScrollLinkToggleButton"
                                                      Width="30"
                                                      Height="42"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Panel.ZIndex="3"
                                                      Background="{StaticResource PrimarySoftBrush}"
                                                      BorderBrush="{StaticResource PrimaryBrush}"
                                                      BorderThickness="1"
                                                      Cursor="Hand"
                                                      Focusable="False"
                                                      IsChecked="True"
                                                      Click="EditorScrollLinkToggleButton_Click"
                                                      ToolTip="Dikey kaydırma bağlantısı açık">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="LinkButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="7">
                                                        <Viewbox Width="17"
                                                                 Height="17"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Canvas Width="24"
                                                                    Height="24">
                                                                <Path x:Name="LinkIcon"
                                                                      Width="24"
                                                                      Height="24"
                                                                      Data="M10.59,13.41 9.17,12 10.59,10.59 12,12 10.59,13.41 M7.05,17.66 5.64,16.24 8.46,13.41 9.88,14.83 7.05,17.66 M16.95,6.34 18.36,7.76 15.54,10.59 14.12,9.17 16.95,6.34 M8.46,15.54 6.34,17.66 C4.78,19.22 2.25,19.22 0.69,17.66 C-0.87,16.1 -0.87,13.57 0.69,12.01 L4.93,7.76 C6.49,6.2 9.02,6.2 10.58,7.76 L11.29,8.47 9.88,9.88 9.17,9.17 C8.39,8.39 7.12,8.39 6.34,9.17 L2.1,13.42 C1.32,14.2 1.32,15.46 2.1,16.24 C2.88,17.02 4.15,17.02 4.93,16.24 L7.05,14.12 8.46,15.54 M15.54,8.46 17.66,6.34 C19.22,4.78 21.75,4.78 23.31,6.34 C24.87,7.9 24.87,10.43 23.31,11.99 L19.07,16.24 C17.51,17.8 14.98,17.8 13.42,16.24 L12.71,15.53 14.12,14.12 14.83,14.83 C15.61,15.61 16.88,15.61 17.66,14.83 L21.9,10.58 C22.68,9.8 22.68,8.54 21.9,7.76 C21.12,6.98 19.85,6.98 19.07,7.76 L16.95,9.88 15.54,8.46"
                                                                      Fill="{StaticResource PrimaryBrush}"
                                                                      Stretch="Uniform">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="90"
                                                                                         CenterX="12"
                                                                                         CenterY="12" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="Background"
                                                                    Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Fill"
                                                                    Value="White" />
                                                        </Trigger>

                                                        <Trigger Property="IsChecked"
                                                                 Value="False">
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="Background"
                                                                    Value="{StaticResource BorderStrongBrush}" />
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource BorderBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Fill"
                                                                    Value="{StaticResource TextMutedBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Opacity"
                                                                    Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>

                                    <Border x:Name="MaskRightEditorCard"
                                            Grid.Column="2"
                                            ClipToBounds="True"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE72E;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Maskelenmiş Kod" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button x:Name="CopyButton"
                                                            Margin="0,0,8,0"
                                                            Click="CopyButton_Click"
                                                            Content="&#xE8C8;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kopyala" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button x:Name="SaveFileButton"
                                                            Margin="0,0,8,0"
                                                            Click="SaveFileButton_Click"
                                                            Content="&#xE74E;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kodu Kaydet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button x:Name="SaveVaultButton"
                                                            Margin="0,0,8,0"
                                                            Click="SaveVaultButton_Click"
                                                            Content="&#xE72E;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Kasa Dosyasını Kaydet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button Click="ExpandEditorButton_Click"
                                                            Content="&#xE740;"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Tag="MaskRight">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Maskelenmiş kod editörünü genişlet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border ClipToBounds="True"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
                                                        <Canvas ClipToBounds="True">
                                                            <TextBlock x:Name="MaskedLineNumbersTextBlock"
                       Canvas.Right="14"
                       Padding="0,12,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       LineHeight="19"
                       Text="1" />
                                                        </Canvas>
                                                    </Border>

                                                    <Canvas Grid.Column="1"
            ClipToBounds="True"
            IsHitTestVisible="False">
                                                        <Border x:Name="MaskedActiveLineBorder"
                Canvas.Left="0"
                Canvas.Right="0"
                Width="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                Height="19"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="#405B8CFF"
                BorderThickness="0,1,0,1"
                Opacity="0"
                IsHitTestVisible="False" />
                                                    </Canvas>

                                                    <RichTextBox x:Name="MaskedSyntaxRichTextBox"
                 Grid.Column="1"
                 Padding="14,12"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="False"
                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                 FontSize="14"
                 IsHitTestVisible="False"
                 IsReadOnly="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />

                                                    <TextBox x:Name="MaskedCodeTextBox"
             Grid.Column="1"
             Padding="14,12"
             AcceptsReturn="True"
             AcceptsTab="True"
             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
             FontSize="14"
             Foreground="Transparent"
             HorizontalScrollBarVisibility="Auto"
             IsReadOnly="True"
             TextBlock.LineHeight="19"
             TextBlock.LineStackingStrategy="BlockLineHeight"
             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
             TextChanged="CodeOutputTextBox_TextChanged"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="MaskStatusBorder"
                                        Grid.Row="2"
                                        Margin="16,6,16,12"
                                        Padding="16,0"
                                        Background="{StaticResource SuccessSurfaceBrush}"
                                        BorderBrush="#205044"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MaskStatusIconBorder"
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <TextBlock x:Name="MaskStatusIconText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                        </Border>
                                        <TextBlock x:Name="MaskStatusTextBlock"
                                                   Grid.Column="1"
                                                   Margin="14,0"
                                                   VerticalAlignment="Center"
                                                   Text="Kod yapıştırabilir veya bir kaynak dosya seçebilirsiniz."
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DismissStatusButton_Click"
                                                Content="&#xE8BB;"
                                                ToolTip="Bildirimi kapat" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Maskeleme ayar çekmecesi -->
                            <Grid x:Name="MaskDrawerLayer"
                                  Panel.ZIndex="20"
                                  Visibility="Collapsed">
                                <Button Background="{StaticResource ScrimBrush}"
                                        BorderThickness="0"
                                        Click="DrawerScrim_Click"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="MaskSettingsDrawer"
                                        Width="500"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          Direction="180"
                                                          Opacity="0.35"
                                                          ShadowDepth="8"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="24,18,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Text="Maskeleme Ayarları" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Kod maskeleme seçeneklerini düzenleyin" />
                                            </StackPanel>
                                            <Button x:Name="MaskDrawerCloseButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="&#xE8BB;"
                                                    ToolTip="Ayarları kapat" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="24,0,24,8">
                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Kaynak dil" />
                                            <ComboBox x:Name="LanguageComboBox"
          SelectionChanged="LanguageComboBox_SelectionChanged"
          SelectedIndex="0">
                                                <ComboBoxItem Content="PL/I" Tag="PL1" />
                                                <ComboBoxItem Content="EGL" Tag="EGL" />
                                                <ComboBoxItem Content="C# / .NET" Tag="CSHARP" />
                                            </ComboBox>

                                            <Border Margin="0,18,0,0"
                                                        Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="MaskSelectedFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
                                                            <TextBlock x:Name="SelectedFileTextBlock"
                                                                           MaxWidth="210"
                                                                           FontWeight="SemiBold"
                                                                           Text="Henüz dosya seçilmedi"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="SelectedFileMetaTextBlock"
                                                                       Margin="22,5,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Text="Kod doğrudan editöre yapıştırılabilir" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                                Click="SelectFileButton_Click"
                                                                Content="Dosyayı Değiştir" />
                                                </Grid>
                                            </Border>

                                            <Border Height="1"
                                                        Margin="0,18"
                                                        Background="{StaticResource BorderBrush}" />

                                            <StackPanel Margin="0,0,0,8"
                                                            Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="Gizlilik Modu" />
                                                <Button Width="24"
                                                            Height="24"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Content="&#xE946;"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            ToolTipService.InitialShowDelay="120"
                                                            ToolTipService.ShowDuration="30000">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                               Text="Gizlilik modları" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="Maksimum Gizlilik, özgün değerlerin uzunluğunu ve yapısını mümkün olduğunca gizler. Önerilen seçenektir."
                                                                               TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,8,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="Biçim Korumalı mod, uzunluk ve karakter biçimini koruduğu için kaynak kod hakkında sınırlı biçim bilgisi gösterebilir."
                                                                               TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>

                                            <RadioButton x:Name="MaximumPrivacyRadioButton"
                                                             GroupName="MaskingMode"
                                                             IsChecked="True"
                                                             Checked="MaskingModeRadioButton_Checked"
                                                             Style="{StaticResource ChoiceCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Maksimum Gizlilik" />
                                                    <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   Text="Özgün değerlerin uzunluğunu ve yapısını mümkün olduğunca gizler."
                                                                   TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="FormatPreservingRadioButton"
                                                             Margin="0,10,0,0"
                                                             GroupName="MaskingMode"
                                                             Checked="MaskingModeRadioButton_Checked"
                                                             Style="{StaticResource ChoiceCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Biçim Korumalı" />
                                                    <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   Text="Uzunluk ve karakter biçimini korur."
                                                                   TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>

                                            <Border Height="1"
                                                        Margin="0,18"
                                                        Background="{StaticResource BorderBrush}" />

                                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="Şifreli Eşleme Kasası" />
                                                <Button Width="24"
                                                            Height="24"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE946;"
                                                            ToolTipService.InitialShowDelay="120"
                                                            ToolTipService.ShowDuration="30000">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                               Text="Kasa parolası güvenliği" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="Kasa parolası en az 12 karakter olmalıdır. Dosyadan Kullan seçeneğinde yalnızca parolayı içeren güvenli bir metin dosyası seçin."
                                                                               TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                               Foreground="{StaticResource WarningBrush}"
                                                                               Text="Parola dosyasını, kasa dosyasını ve maskelenmiş kodu aynı konumda saklamayın."
                                                                               TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>

                                            <Border Padding="3"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="ManualVaultPasswordRadioButton"
                                                                     GroupName="VaultPasswordSource"
                                                                     Content="Elle Gir"
                                                                     IsChecked="True"
                                                                     Checked="VaultPasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                    <RadioButton x:Name="FileVaultPasswordRadioButton"
                                                                     Grid.Column="1"
                                                                     GroupName="VaultPasswordSource"
                                                                     Content="Dosyadan Kullan"
                                                                     Checked="VaultPasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel x:Name="ManualVaultPasswordPanel" Margin="0,10,0,0">
                                                <Border Style="{StaticResource PasswordInputStyle}">
                                                    <Grid>
                                                        <TextBlock x:Name="VaultPasswordPlaceholderTextBlock"
                                                                       Margin="14,0,48,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       IsHitTestVisible="False"
                                                                       Text="Kasa parolasını girin" />
                                                        <PasswordBox x:Name="VaultPasswordBox"
                                                                         Margin="12,0,48,0"
                                                                         MaxLength="128"
                                                                         PasswordChanged="VaultPasswordInput_Changed" />
                                                        <TextBox x:Name="VaultPasswordTextBox"
                                                                     Margin="12,0,48,0"
                                                                     MaxLength="128"
                                                                     TextChanged="VaultPasswordInput_Changed"
                                                                     Visibility="Collapsed" />
                                                        <Button x:Name="VaultPasswordVisibilityButton"
                                                                    Width="42"
                                                                    Height="42"
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Click="VaultPasswordVisibilityButton_Click"
                                                                    Content="&#xE890;"
                                                                    ToolTip="Parolayı göster veya gizle" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="VaultPasswordValidationTextBlock"
                                                               Margin="2,8,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               Text="En az 12 karakterlik güçlü bir parola kullanın." />
                                            </StackPanel>

                                            <Border x:Name="VaultPasswordFilePanel"
                                                        Margin="0,10,0,0"
                                                        Padding="12"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="VaultPasswordFileTextBlock"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="Parola dosyası seçilmedi"
                                                                   TextWrapping="Wrap" />
                                                    <Button Grid.Column="1"
                                                                MinWidth="92"
                                                                Click="SelectVaultPasswordFileButton_Click"
                                                                Content="Dosya Seç" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="24,12,24,22">
                                            <Button x:Name="MaskButton"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="MaskButton_Click"
                                                    Content="⛨  Ayarları Uygula ve Maskele"
                                                    IsEnabled="False" />
                                            <Button Margin="0,8,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="İptal" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE7A7;" />
                                <TextBlock Text="Kodu Geri Aç" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid x:Name="RestoreWorkspace">
                            <Grid x:Name="RestoreFocusContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>

                                <!-- Geri açma özet şeridi -->
                                <Border Grid.Row="0"
                                        Margin="16,8,16,6"
                                        Background="{StaticResource EditorBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock x:Name="RestoreMaskedFileSummaryIcon"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="○" />
                                            <TextBlock x:Name="SelectedMaskedFileSummaryTextBlock"
                                                       MaxWidth="200"
                                                       Text="Maskelenmiş dosya seçilmedi"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="28,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock x:Name="RestoreVaultFileSummaryIcon"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="○" />
                                            <TextBlock x:Name="SelectedVaultFileSummaryTextBlock"
                                                       MaxWidth="190"
                                                       Text="Kasa seçilmedi"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Margin="28,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock x:Name="RestorePasswordSummaryIcon"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="○" />
                                            <TextBlock x:Name="RestorePasswordSummaryTextBlock"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Parola bekleniyor" />
                                        </StackPanel>

                                        <Button x:Name="RestoreSettingsButton"
                                                Grid.Column="3"
                                                Margin="24,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="RestoreSettingsToggleButton_Click"
                                                Content="&#xE713;"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                ToolTip="Geri açma ayarlarını aç" />

                                    </Grid>
                                </Border>

                                <!-- Geri açma editörleri -->
                                <Grid x:Name="RestoreEditorGrid" Grid.Row="1" Margin="16,8,16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RestoreLeftColumn" Width="*" MinWidth="300" />
                                        <ColumnDefinition x:Name="RestoreSplitterColumn" Width="14" />
                                        <ColumnDefinition x:Name="RestoreRightColumn" Width="*" MinWidth="300" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="RestoreLeftEditorCard"
                                            Grid.Column="0"
                                            ClipToBounds="True"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE72E;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Maskelenmiş Kod" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="ExpandEditorButton_Click"
                                                        Tag="RestoreLeft"
                                                        Content="&#xE740;"
                                                        ToolTip="Maskelenmiş kod editörünü genişlet" />
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border ClipToBounds="True"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
                                                        <Canvas ClipToBounds="True">
                                                            <TextBlock x:Name="MaskedInputLineNumbersTextBlock"
                       Canvas.Right="14"
                       Padding="0,12,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       LineHeight="19"
                       Text="1" />
                                                        </Canvas>
                                                    </Border>

                                                    <Canvas Grid.Column="1"
            ClipToBounds="True"
            IsHitTestVisible="False">
                                                        <Border x:Name="MaskedInputActiveLineBorder"
                Canvas.Left="0"
                Canvas.Right="0"
                Width="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                Height="19"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="#405B8CFF"
                BorderThickness="0,1,0,1"
                Opacity="0"
                IsHitTestVisible="False" />
                                                    </Canvas>

                                                    <RichTextBox x:Name="MaskedInputSyntaxRichTextBox"
                 Grid.Column="1"
                 Padding="14,12"
                 Background="Transparent"
                 BorderThickness="0"
                 ClipToBounds="True"
                 Focusable="False"
                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                 FontSize="14"
                 IsHitTestVisible="False"
                 IsReadOnly="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />

                                                    <TextBox x:Name="MaskedInputTextBox"
             Grid.Column="1"
             Padding="14,12"
             AcceptsReturn="True"
             AcceptsTab="True"
             ClipToBounds="True"
             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
             FontSize="14"
             Foreground="Transparent"
             HorizontalScrollBarVisibility="Auto"
             TextBlock.LineHeight="19"
             TextBlock.LineStackingStrategy="BlockLineHeight"
             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
             TextChanged="MaskedInputTextBox_TextChanged"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1"
                                          Width="14"
                                          Panel.ZIndex="2">
                                        <GridSplitter x:Name="RestoreGridSplitter"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  Cursor="SizeWE"
                                                  DragDelta="EditorGridSplitter_DragDelta"
                                                  MouseDoubleClick="EditorGridSplitter_MouseDoubleClick"
                                                  ResizeBehavior="PreviousAndNext"
                                                  ResizeDirection="Columns"
                                                  ShowsPreview="False"
                                                  ToolTip="Editörlerin genişliğini değiştirmek için sürükleyin. Sıfırlamak için çift tıklayın.">
                                            <GridSplitter.Template>
                                                <ControlTemplate TargetType="GridSplitter">
                                                    <Border x:Name="SplitterHitArea"
                                                        Width="14"
                                                        Background="Transparent">
                                                        <Border x:Name="SplitterHandle"
                                                            Width="6"
                                                            Height="54"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource BorderStrongBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                            <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                                <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Margin="0,1.5"
                                                                     Fill="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#101B2E" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimarySoftBrush}" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="SplitterHitArea"
                                                                Property="Background"
                                                                Value="#17243A" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="SplitterHandle"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </GridSplitter.Template>
                                        </GridSplitter>

                                        <ToggleButton x:Name="RestoreScrollLinkToggleButton"
                                                      Width="30"
                                                      Height="42"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Panel.ZIndex="3"
                                                      Background="{StaticResource PrimarySoftBrush}"
                                                      BorderBrush="{StaticResource PrimaryBrush}"
                                                      BorderThickness="1"
                                                      Cursor="Hand"
                                                      Focusable="False"
                                                      IsChecked="True"
                                                      Click="EditorScrollLinkToggleButton_Click"
                                                      ToolTip="Dikey kaydırma bağlantısı açık">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="LinkButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="7">
                                                        <Viewbox Width="17"
                                                                 Height="17"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Canvas Width="24"
                                                                    Height="24">
                                                                <Path x:Name="LinkIcon"
                                                                      Width="24"
                                                                      Height="24"
                                                                      Data="M10.59,13.41 9.17,12 10.59,10.59 12,12 10.59,13.41 M7.05,17.66 5.64,16.24 8.46,13.41 9.88,14.83 7.05,17.66 M16.95,6.34 18.36,7.76 15.54,10.59 14.12,9.17 16.95,6.34 M8.46,15.54 6.34,17.66 C4.78,19.22 2.25,19.22 0.69,17.66 C-0.87,16.1 -0.87,13.57 0.69,12.01 L4.93,7.76 C6.49,6.2 9.02,6.2 10.58,7.76 L11.29,8.47 9.88,9.88 9.17,9.17 C8.39,8.39 7.12,8.39 6.34,9.17 L2.1,13.42 C1.32,14.2 1.32,15.46 2.1,16.24 C2.88,17.02 4.15,17.02 4.93,16.24 L7.05,14.12 8.46,15.54 M15.54,8.46 17.66,6.34 C19.22,4.78 21.75,4.78 23.31,6.34 C24.87,7.9 24.87,10.43 23.31,11.99 L19.07,16.24 C17.51,17.8 14.98,17.8 13.42,16.24 L12.71,15.53 14.12,14.12 14.83,14.83 C15.61,15.61 16.88,15.61 17.66,14.83 L21.9,10.58 C22.68,9.8 22.68,8.54 21.9,7.76 C21.12,6.98 19.85,6.98 19.07,7.76 L16.95,9.88 15.54,8.46"
                                                                      Fill="{StaticResource PrimaryBrush}"
                                                                      Stretch="Uniform">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="90"
                                                                                         CenterX="12"
                                                                                         CenterY="12" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="Background"
                                                                    Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Fill"
                                                                    Value="White" />
                                                        </Trigger>

                                                        <Trigger Property="IsChecked"
                                                                 Value="False">
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="Background"
                                                                    Value="{StaticResource BorderStrongBrush}" />
                                                            <Setter TargetName="LinkButtonBorder"
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource BorderBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Fill"
                                                                    Value="{StaticResource TextMutedBrush}" />
                                                            <Setter TargetName="LinkIcon"
                                                                    Property="Opacity"
                                                                    Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>

                                    <Border x:Name="RestoreRightEditorCard"
                                            Grid.Column="2"
                                            ClipToBounds="True"
                                            Style="{StaticResource EditorCardStyle}">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="2,0,10,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17"
                                                               Text="&#xE8D7;" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="Geri Açılmış Kod" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button x:Name="CopyRestoredButton"
                                                            Margin="0,0,8,0"
                                                            Click="CopyRestoredButton_Click"
                                                            Content="&#xE8C8;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Sonucu Kopyala" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button x:Name="SaveRestoredFileButton"
                                                            Margin="0,0,8,0"
                                                            Click="SaveRestoredFileButton_Click"
                                                            Content="&#xE74E;"
                                                            IsEnabled="False"
                                                            Style="{StaticResource OutputActionIconButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Sonucu Kaydet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button Click="ExpandEditorButton_Click"
                                                            Content="&#xE740;"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Tag="RestoreRight">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoBubbleToolTipStyle}">
                                                                <TextBlock Text="Geri açılmış kod editörünü genişlet" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource EditorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border ClipToBounds="True"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
                                                        <Canvas ClipToBounds="True">
                                                            <TextBlock x:Name="RestoredLineNumbersTextBlock"
                       Canvas.Right="14"
                       Padding="0,12,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       LineHeight="19"
                       Text="1" />
                                                        </Canvas>
                                                    </Border>

                                                    <Canvas Grid.Column="1"
            ClipToBounds="True"
            IsHitTestVisible="False">
                                                        <Border x:Name="RestoredActiveLineBorder"
                Canvas.Left="0"
                Canvas.Right="0"
                Width="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                Height="19"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="#405B8CFF"
                BorderThickness="0,1,0,1"
                Opacity="0"
                IsHitTestVisible="False" />
                                                    </Canvas>

                                                    <RichTextBox x:Name="RestoredSyntaxRichTextBox"
                 Grid.Column="1"
                 Padding="14,12"
                 Background="Transparent"
                 BorderThickness="0"
                 ClipToBounds="True"
                 Focusable="False"
                 FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                 FontSize="14"
                 IsHitTestVisible="False"
                 IsReadOnly="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />

                                                    <TextBox x:Name="RestoredCodeTextBox"
             Grid.Column="1"
             Padding="14,12"
             AcceptsReturn="True"
             AcceptsTab="True"
             ClipToBounds="True"
             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
             FontSize="14"
             Foreground="Transparent"
             HorizontalScrollBarVisibility="Auto"
             IsReadOnly="True"
             TextBlock.LineHeight="19"
             TextBlock.LineStackingStrategy="BlockLineHeight"
             ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
             TextChanged="CodeOutputTextBox_TextChanged"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="RestoreStatusBorder"
                                        Grid.Row="2"
                                        Margin="16,6,16,12"
                                        Padding="16,0"
                                        Background="{StaticResource SuccessSurfaceBrush}"
                                        BorderBrush="#205044"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="RestoreStatusIconBorder"
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <TextBlock x:Name="RestoreStatusIconText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="✓" />
                                        </Border>
                                        <TextBlock x:Name="RestoreStatusTextBlock"
                                                   Grid.Column="1"
                                                   Margin="14,0"
                                                   VerticalAlignment="Center"
                                                   Text="Maskelenmiş dosya, kasa ve parola seçerek kodu geri açabilirsiniz."
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DismissStatusButton_Click"
                                                Content="&#xE8BB;"
                                                ToolTip="Bildirimi kapat" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Geri açma ayar çekmecesi -->
                            <Grid x:Name="RestoreDrawerLayer"
                                  Panel.ZIndex="20"
                                  Visibility="Collapsed">
                                <Button Background="{StaticResource ScrimBrush}"
                                        BorderThickness="0"
                                        Click="DrawerScrim_Click"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="RestoreSettingsDrawer"
                                        Width="450"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          Direction="180"
                                                          Opacity="0.35"
                                                          ShadowDepth="8"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="24,18,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Text="Geri Açma Ayarları" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Dosya ve kasa doğrulama seçeneklerini düzenleyin" />
                                            </StackPanel>
                                            <Button x:Name="RestoreDrawerCloseButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="&#xE8BB;"
                                                    ToolTip="Ayarları kapat" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="24,0,24,8">
                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Maskelenmiş Dosya" />
                                            <Border Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="RestoreMaskedFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
                                                            <TextBlock x:Name="SelectedMaskedFileTextBlock"
                                                                           MaxWidth="210"
                                                                           FontWeight="SemiBold"
                                                                           Text="Dosya seçilmedi"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="SelectedMaskedFileMetaTextBlock"
                                                                       Margin="22,5,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Text="Desteklenen: .pli, .pl1, .egl, .cs" />
                                                    </StackPanel>
                                                    <Button x:Name="SelectMaskedFileButton"
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Click="SelectMaskedFileButton_Click"
                                                                Content="Dosya Seç" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Margin="0,20,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Şifreli Eşleme Kasası" />
                                            <Border Padding="14"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="RestoreVaultFileDrawerIcon"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="○" />
                                                            <TextBlock x:Name="SelectedVaultFileTextBlock"
                                                                           MaxWidth="210"
                                                                           FontWeight="SemiBold"
                                                                           Text="Kasa seçilmedi"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="SelectedVaultFileMetaTextBlock"
                                                                       Margin="22,5,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Text=".mcvault dosyası seçin" />
                                                    </StackPanel>
                                                    <Button x:Name="SelectVaultFileButton"
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Click="SelectVaultFileButton_Click"
                                                                Content="Kasa Dosyası Seç" />
                                                </Grid>
                                            </Border>

                                            <Border Height="1"
                                                        Margin="0,20"
                                                        Background="{StaticResource BorderBrush}" />

                                            <TextBlock Margin="0,0,0,8"
                                                           FontWeight="SemiBold"
                                                           Text="Parola Yöntemi" />
                                            <Border Padding="3"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="ManualRestorePasswordRadioButton"
                                                                     GroupName="RestorePasswordSource"
                                                                     Content="Parolayı Elle Gir"
                                                                     IsChecked="True"
                                                                     Checked="RestorePasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                    <RadioButton x:Name="FileRestorePasswordRadioButton"
                                                                     Grid.Column="1"
                                                                     GroupName="RestorePasswordSource"
                                                                     Content="Parolayı Dosyadan Kullan"
                                                                     Checked="RestorePasswordSource_Changed"
                                                                     Style="{StaticResource SegmentToggleStyle}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel x:Name="ManualRestorePasswordPanel" Margin="0,10,0,0">
                                                <Border Style="{StaticResource PasswordInputStyle}">
                                                    <Grid>
                                                        <TextBlock x:Name="RestorePasswordPlaceholderTextBlock"
                                                                       Margin="14,0,48,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       IsHitTestVisible="False"
                                                                       Text="Kasa parolasını girin" />
                                                        <PasswordBox x:Name="RestoreVaultPasswordBox"
                                                                         Margin="12,0,48,0"
                                                                         MaxLength="128"
                                                                         PasswordChanged="RestorePasswordInput_Changed" />
                                                        <TextBox x:Name="RestoreVaultPasswordTextBox"
                                                                     Margin="12,0,48,0"
                                                                     MaxLength="128"
                                                                     TextChanged="RestorePasswordInput_Changed"
                                                                     Visibility="Collapsed" />
                                                        <Button x:Name="RestorePasswordVisibilityButton"
                                                                    Width="42"
                                                                    Height="42"
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Click="RestorePasswordVisibilityButton_Click"
                                                                    Content="&#xE890;"
                                                                    ToolTip="Parolayı göster veya gizle" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="RestorePasswordValidationTextBlock"
                                                               Margin="2,8,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               Text="Kasa parolasını girin." />
                                            </StackPanel>

                                            <Border x:Name="RestorePasswordFilePanel"
                                                        Margin="0,10,0,0"
                                                        Padding="12"
                                                        Background="{StaticResource EditorBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RestorePasswordFileTextBlock"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="Parola dosyası seçilmedi"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                Click="SelectRestorePasswordFileButton_Click"
                                                                Content="Dosya Seç" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="24,12,24,22">
                                            <Button x:Name="UnmaskButton"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="UnmaskButton_Click"
                                                    Content="⛨  Ayarları Uygula ve Kodu Geri Aç"
                                                    IsEnabled="False" />
                                            <Button Margin="0,8,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="CloseSettingsDrawerButton_Click"
                                                    Content="İptal" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Mevcut iş mantığının ortak durum hedefi -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Text="Kod yapıştırabilir veya bir kaynak dosya seçebilirsiniz." />
        </Grid>
    </Border>
</Window>
