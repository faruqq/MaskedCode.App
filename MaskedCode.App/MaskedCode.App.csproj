<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<ApplicationIcon>Assets\Icons\MaskedCode1.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
		<PackageReference Include="xunit" Version="2.5.3" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\Animations\ClassicVideo\**\*.*" />
		<None Remove="Assets\Animations\MaskState\**\*.*" />
		<None Remove="Assets\Brand\maskod-logo.png" />
		<None Remove="Assets\Icons\user-guide-book-info.png" />
		<None Remove="Assets\Icons\user-guide-document-info.png" />
		<None Remove="Assets\Animations\OperationLoader\**\*.*" />

		<Resource Include="Assets\Brand\maskod-logo.png" />

		<Resource Include="Assets\Icons\user-guide-book-info.png" />

		<Resource Include="Assets\Icons\user-guide-document-info.png" />

		<Content Include="Assets\Animations\ClassicVideo\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Assets\Animations\MaskState\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Assets\Animations\OperationLoader\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Assets\Animations\MaskState\Transitions\" />
		<Folder Include="Assets\Brand\" />
	</ItemGroup>

</Project>